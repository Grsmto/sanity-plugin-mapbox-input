{
  "name": "sanity-plugin-mapbox-input",
  "version": "1.0.0",
  "description": "Sanity plugin providing input handlers for geo-related input types using Mapbox",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "mapbox-input",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/Grsmto/sanity-plugin-mapbox-input#readme",
  "bugs": {
    "url": "https://github.com/Grsmto/sanity-plugin-mapbox-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grsmto/sanity-plugin-mapbox-input.git"
  },
  "license": "MIT",
  "author": "Adrien Denat",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browserslist": "extends @sanity/browserslist-config",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "styles",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "dev": "npm run --prefix playground dev",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.3",
    "@sanity/icons": "^5.2.3",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^4.4.10",
    "mapbox-gl": "^3.33.0",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^6.13.4",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0",
    "typescript": "~5.7.3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^3 || ^4 || ^5 || ^6"
  },
  "engines": {
    "node": ">=18"
  }
}
